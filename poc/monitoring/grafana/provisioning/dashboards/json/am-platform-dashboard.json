      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  tx_id,\n  channel,\n  receiver,\n  status,\n  result_code,\n  retry_count,\n  CASE\n    WHEN status = 'DELIVERED' THEN 'NiFi ✅  Kafka ✅  Flink ✅  Adapter ✅  결과수신 ✅  DB ✅'\n    WHEN status = 'FAILED' AND dispatched_at IS NULL THEN 'NiFi ✅  Kafka ✅  Flink ❌  Adapter ⬜  결과수신 ⬜  DB ⬜'\n    WHEN status = 'FAILED' AND dispatched_at IS NOT NULL THEN 'NiFi ✅  Kafka ✅  Flink ✅  Adapter ✅  결과수신 ❌  DB ⬜'\n    WHEN status = 'DLQ' THEN 'NiFi ✅  Kafka ✅  Flink ✅  Adapter ✅  결과수신 ❌  DB(DLQ) ✅'\n    WHEN status = 'DISPATCHING' THEN 'NiFi ✅  Kafka ✅  Flink ✅  Adapter 🔄  결과수신 ⬜  DB ⬜'\n    ELSE 'NiFi ✅  Kafka ✅  Flink 🔄  Adapter ⬜  결과수신 ⬜  DB ⬜'\n  END AS pipeline,\n  CASE\n    WHEN delivered_at IS NOT NULL AND requested_at IS NOT NULL\n    THEN ROUND(EXTRACT(EPOCH FROM (delivered_at - requested_at)) * 1000) || 'ms'\n    ELSE '-'\n  END AS elapsed,\n  CONCAT('http://localhost:8200/ui/trace.html?txId=', tx_id) AS \"상세추적\",\n  TO_CHAR(requested_at AT TIME ZONE 'Asia/Seoul', 'MM-DD HH24:MI:SS') AS requested_at\nFROM msg_send_history\nWHERE\n  ('${txId}' = '' OR tx_id = '${txId}')\n  AND ('${receiver}' = '' OR receiver = '${receiver}')\n  AND ('${channel}' = 'ALL' OR channel = '${channel}')\n  AND ('${status}' = 'ALL' OR status = '${status}')\n  AND (NULLIF('${dateFrom}', '') IS NULL OR requested_at >= NULLIF('${dateFrom}', '')::timestamptz)\n  AND (NULLIF('${dateTo}',   '') IS NULL OR requested_at <= NULLIF('${dateTo}',   '')::timestamptz)\nORDER BY requested_at DESC NULLS LAST\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "📋 발송 이력 조회 — txId / 수신번호 / 채널 / 상태 / 기간 검색",
